# ==============================================================================
# TelegramAgriBot Environment Configuration
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Admin User IDs (Comma-separated integers)
# Users with these IDs can access the /admin panel in the bot.
# Obtain your ID by sending /start or /id to @userinfobot or @raw_data_bot on Telegram.
ADMIN_IDS=123456789,987654321

# Default AI Settings (can be dynamically updated inside the bot via /admin)
DEFAULT_PROVIDER_NAME=OpenRouter
DEFAULT_MODEL_NAME=openrouter/free
DEFAULT_API_URL=https://openrouter.ai/api/v1/chat/completions
DEFAULT_API_KEY=your_openrouter_api_key_here

# Enable Advanced Reasoning (injects {"reasoning": {"enabled": true}} into OpenRouter/DeepSeek payloads)
ENABLE_ADVANCED_REASONING=false

# Quotas and Limits: Maximum number of bot requests before requiring quota reset (0 for unlimited)
DEFAULT_MAX_REQUESTS=50

# Database file path
DATABASE_PATH=agribot.db
